#!/usr/bin/env python3
"""Write scripts/migrate-manifest.json: what `lane migrate` needs to know about the git-clone installs it converts.

  python3 scripts/release-migrate-manifest          rewrite the manifest from this repo's tags and HEAD
  python3 scripts/release-migrate-manifest --check  exit 1 when the manifest is out of date (tests/t_migrate.sh runs it)

An installed package carries no git history, so the facts are written down here, at release time, from git:
  files              every path a clone ships, in each 0.9.x release and in HEAD (the release being made), with the git
                     blob ids it had in those releases: the files `lane migrate` removes from a clone (and the only
                     ones; anything else in the folder is the user's), and the ids that tell an unchanged one apart
  claude_templates   every CLAUDE.md.template a release ever shipped: a clone's CLAUDE.md was made from one of them,
                     and the user's own lines are what differs
  settings_allow     every permissions.allow entry a release's .claude/settings.json shipped (Repolane's, not the user's)
This script is release tooling (scripts/release-*, left out of the wheel); the JSON it writes ships with the product.
Re-run it whenever a file is added to or removed from the repo.
"""
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
OUT = os.path.join(HERE, "scripts", "migrate-manifest.json")
RELEASES = ("v0.9.0", "v0.9.1", "v0.9.2")


def git(*a):
    return subprocess.run(["git", "-C", HERE, *a], capture_output=True, text=True, check=True).stdout


def tree(ref):
    out = {}
    for line in git("ls-tree", "-r", "-z", ref).split("\0"):
        if not line: continue
        meta, path = line.split("\t", 1)
        _, kind, sha = meta.split()
        if kind == "blob": out[path] = sha
    return out


def build():
    tags = set(git("tag", "--list", "v*").split())
    files = {}
    for t in RELEASES:
        if t not in tags: sys.exit(f"release-migrate-manifest: tag {t} is missing (fetch the tags first)")
        for p, sha in tree(t).items():
            files.setdefault(p, set()).add(sha)
    # HEAD's paths: the release being made. Its own ids are not recorded (they change with every commit); a file at one of
    # these paths is compared with the installed product's copy instead.
    head = set(git("ls-files", "-z").split("\0")) - {""}
    head.add("scripts/migrate-manifest.json")
    for p in head:
        files.setdefault(p, set())
    templates, allow = [], set()
    for t in sorted(tags, key=lambda v: [int(x) if x.isdigit() else x for x in v[1:].replace("-", ".").split(".")]):
        try: txt = git("show", f"{t}:CLAUDE.md.template")
        except subprocess.CalledProcessError: txt = None
        if txt and txt not in templates: templates.append(txt)
        try: st = json.loads(git("show", f"{t}:.claude/settings.json"))
        except (subprocess.CalledProcessError, ValueError): st = {}
        allow |= set((st.get("permissions") or {}).get("allow") or [])
    with open(os.path.join(HERE, "CLAUDE.md.template")) as fh: txt = fh.read()
    if txt not in templates: templates.append(txt)
    return {"releases": list(RELEASES), "files": {p: sorted(s) for p, s in sorted(files.items())},
            "claude_templates": templates, "settings_allow": sorted(allow)}


def main():
    data = json.dumps(build(), indent=1, sort_keys=True) + "\n"
    if "--check" in sys.argv[1:]:
        try:
            with open(OUT) as fh: cur = fh.read()
        except OSError:
            cur = ""
        if cur != data:
            print("scripts/migrate-manifest.json is out of date: run python3 scripts/release-migrate-manifest", file=sys.stderr)
            return 1
        return 0
    with open(OUT, "w") as fh: fh.write(data)
    print(f"wrote {os.path.relpath(OUT, HERE)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
